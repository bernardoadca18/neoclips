# NeoClips Environment Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_ENV=development
APP_NAME=neoclips
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8020

# Database
DATABASE_URL=postgresql+asyncpg://neoclips:neoclips@localhost:5432/neoclips
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_QUEUE_NAME=neoclips
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# External Services (for future stages)
# MEDIA_INDEXER_URL=http://localhost:8010
# VIDEO_COMPOSER_URL=http://localhost:8030
